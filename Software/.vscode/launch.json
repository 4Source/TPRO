{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Unit Tests",
            "type": "cppdbg",
            "request": "launch",
            // Pfad zu compiled test binary
            "program": "${workspaceFolder}/unittest/build_unit/effect_json/test_effects",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "ESP-IDF Debug",
            "type": "cppdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}/build",
            "program": "${workspaceFolder}/build/light-wall.elf",
            "miDebuggerPath": "/opt/esp/espressif_tools/tools/xtensa-esp-elf-gdb/16.3_20250913/xtensa-esp-elf-gdb/bin/xtensa-esp32s3-elf-gdb",
            "setupCommands": [
                {
                    "text": "target remote localhost:3333"
                },
                {
                    "text": "set remote hardware-watchpoint-limit 2"
                },
                {
                    "text": "monitor reset halt"
                },
                {
                    "text": "flushregs"
                },
            ],
            "preLaunchTask": "ESP-IDF: OpenOCD (USB JTAG)",
            "postDebugTask": "ESP-IDF: Stop OpenOCD"
        }
    ]
}